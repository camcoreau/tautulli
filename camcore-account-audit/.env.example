TAUTULLI_URL=http://tautulli:8181
TAUTULLI_API_KEY=set-in-the-deployment-secret-store
YOUTRACK_URL=https://support.camcore.au
YOUTRACK_PROJECT_ID=CMA
YOUTRACK_TOKEN=set-in-the-deployment-secret-store

INACTIVE_DAYS=60
NEVER_USED_DAYS=14
EXCLUDED_USERS=Guest,Local
REGISTRY_PATH=/data/registry.json
HTTP_TIMEOUT_SECONDS=20

# Keep true during the first production observation run.
DRY_RUN=true

# Set to 86400 for a continuously running daily sidecar, or 0 for one-shot mode.
AUDIT_INTERVAL_SECONDS=86400
